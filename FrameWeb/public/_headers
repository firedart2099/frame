# O player embute fontes de terceiros num iframe e busca vídeo pelo /api/proxy,
# entao nao da pra trancar com CSP restritiva sem quebrar a reproducao.
# O que da pra fechar sem custo esta aqui.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

/assets/*
  Cache-Control: public, max-age=31536000, immutable
